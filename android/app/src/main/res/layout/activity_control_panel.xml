<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ekran Kaydı"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/audioLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ses"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/audioSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/screenLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ekran"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <Spinner
        android:id="@+id/screenSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/resolutionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Çözünürlük"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <Spinner
        android:id="@+id/resolutionSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/fpsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FPS"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <Spinner
        android:id="@+id/fpsSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kaydı Başlat"
        android:layout_marginTop="24dp" />

</LinearLayout>
