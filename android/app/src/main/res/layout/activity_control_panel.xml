<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#FFFCFF"
    app:cardCornerRadius="28dp"
    app:cardElevation="12dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STELLAR VIDEOR"
                android:textColor="#52627A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Kayıt paneli"
                android:textColor="#101828"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Başlatınca Android seçim ekranı açılır, sonra oyununa dönersin."
                android:textColor="#667085"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="SES"
                android:textColor="#52627A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/audioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton android:id="@+id/audioOff" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Sessiz" />
                <RadioButton android:id="@+id/audioMedia" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Medya sesi" />
                <RadioButton android:id="@+id/audioMicrophone" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Mikrofon" />
                <RadioButton android:id="@+id/audioMicrophoneMedia" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Mikrofon + medya" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="EKRAN"
                android:textColor="#52627A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/screenGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/screenFull" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Tam ekran" />
                <RadioButton android:id="@+id/screenCropped" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Kırp" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="KALİTE"
                android:textColor="#52627A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/resolutionSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Kaydı başlat"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_screen_record"
                app:iconGravity="textStart" />
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
