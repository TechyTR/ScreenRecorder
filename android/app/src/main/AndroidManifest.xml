<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <uses-permission
        android:name="android.permission.RECORD_AUDIO" />

    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="Ekran Kaydedici"
        android:theme="@style/Theme.StellarVideoR">

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".ControlPanelActivity"
            android:exported="false"
            android:theme="@style/Theme.StellarVideoR.Panel" />

        <activity
            android:name=".CountdownActivity"
            android:exported="false"
            android:theme="@style/Theme.StellarVideoR.Countdown" />

        <activity
            android:name=".CropSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.StellarVideoR.Countdown" />

        <receiver
            android:name=".QuickSettingsStateReceiver"
            android:exported="false" />

        <receiver
            android:name=".RecordingControlReceiver"
            android:exported="false" />

        <service
            android:name=".ScreenRecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".RecordingTileService"
            android:label="Ekran Kaydı"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">

            <intent-filter>
                <action
                    android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

        </service>

    </application>

</manifest>
